{
  "name": "eden-laptop-os",
  "version": "0.8.0-preview.9",
  "private": true,
  "description": "EDEN LAPTOP-OS audited one-consent local start with complete UI manifest and Gate 5 read-only planning",
  "type": "module",
  "bin": {
    "eden": "./bin/eden.mjs"
  },
  "scripts": {
    "setup": "node bin/eden.mjs setup",
    "doctor": "node bin/eden.mjs doctor",
    "start": "node bin/eden.mjs quickstart",
    "status": "node bin/eden.mjs status",
    "verify": "node bin/eden.mjs verify",
    "test": "node --test tests/*.test.mjs",
    "launch": "node bin/eden.mjs launch",
    "publish:preview": "node bin/eden.mjs publish-github --dry-run",
    "go": "node bin/eden.mjs quickstart",
    "test:quickstart": "node --test tests/quickstart.test.mjs",
    "reboot:plan": "node bin/eden.mjs reboot-plan",
    "test:reboot": "node --test tests/reboot-plan.test.mjs",
    "gate5": "node bin/eden.mjs gate5",
    "test:gate5": "node --test tests/gate5-preflight.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "files": [
    "config/",
    "bin/",
    "lib/",
    "web/",
    "docs/",
    "tests/",
    "LICENSE",
    "README.md",
    "npm-shrinkwrap.json"
  ],
  "keywords": [
    "eden",
    "windows",
    "setup",
    "guided",
    "security",
    "no-destructive-operations",
    "linux",
    "virtual-machine",
    "one-consent",
    "qubes-whonix-plan",
    "tails-live-separate",
    "reboot-readiness-plan",
    "read-only-qubes-migration",
