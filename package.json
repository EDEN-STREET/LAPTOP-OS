{
  "name": "eden-laptop-os",
  "version": "0.8.0-preview.5",
  "private": true,
  "description": "EDEN LAPTOP-OS single-consent local npm preview for Windows/Linux; no operating-system or disk changes",
  "type": "module",
  "bin": {
    "eden": "./bin/eden.mjs"
  },
  "scripts": {
    "setup": "node bin/eden.mjs setup",
    "doctor": "node bin/eden.mjs doctor",
    "start": "node bin/eden.mjs quickstart",
    "status": "node bin/eden.mjs status",
    "verify": "node bin/eden.mjs verify",
    "test": "node --test tests/*.test.mjs",
    "launch": "node bin/eden.mjs launch",
    "publish:preview": "node bin/eden.mjs publish-github --dry-run",
    "go": "node bin/eden.mjs quickstart",
    "test:quickstart": "node --test tests/quickstart.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "files": [
    "bin/",
    "lib/",
    "web/",
    "docs/",
    "tests/",
    "LICENSE",
    "README.md",
    "npm-shrinkwrap.json"
  ],
  "keywords": [
    "eden",
    "windows",
    "setup",
    "guided",
    "security",
    "no-destructive-operations",
    "linux",
    "virtual-machine",
    "one-consent",
    "qubes-whonix-plan",
    "tails-live-separate"
  ]
}
