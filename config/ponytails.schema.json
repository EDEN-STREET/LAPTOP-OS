{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EDEN Ponytails Message",
  "type": "object",
  "additionalProperties": false,
  "required": ["message_id","goal_id","from","to","kind","classification","ttl","payload"],
  "properties": {
    "message_id": {"type":"string","minLength":8,"maxLength":80},
    "goal_id": {"type":"string","minLength":4,"maxLength":80},
    "task_id": {"type":"string","maxLength":80},
    "reply_to": {"type":"string","maxLength":80},
    "from": {"type":"string","maxLength":80},
    "to": {"type":"string","maxLength":80},
    "kind": {"enum":["goal","task","proposal","result","critique","verification","event"]},
    "classification": {"enum":["public","internal","source-sensitive"]},
    "ttl": {"type":"integer","minimum":1,"maximum":32},
    "payload": {"type":"object"},
    "identity_fields_allowed": {"const": false}
  }
}
